#!/usr/bin/env bash
# Start `qwen` inside a tmux session that mogeung can host in a pane.
#
#   qwenmo                  start a NEW session for this directory
#   qwenmo -d               same, but headless: don't attach this terminal.
#                           mogeung's Terminal pane becomes the session's only
#                           head; the session name is printed for scripting.
#   qwenmo -- -m my-model   anything after the flags is passed through to qwen
#
# This is `yolomo` for Qwen Code, and it is a deliberate sibling rather than a
# flag on that script. The two differ in the only two lines that matter — the
# binary and its approve-everything flag — and ADR-0029 took the same position
# one directory over: with three agent CLIs, visible duplication is cheaper
# than an abstraction that has to be held in your head to know what runs.
# **They must move together.** A fix to the tmux handling below belongs in
# `yolomo` too, and vice versa.
#
# Every run starts a fresh agent: two runs in one directory are two sessions
# (mogeung-qwen-api, mogeung-qwen-api-2, …), not two clients of one agent. To
# re-attach to a session you detached from (or started with -d), use tmux:
#
#   tmux attach -t mogeung-qwen-<dir>
#
# The name carries `qwen` so a Claude session and a Qwen session in the same
# directory are tellable apart in `tmux ls`. Nothing in mogeung parses it —
# panes are matched by process ancestry, not by name — so it is for you.
#
# Why tmux at all: a pty has exactly one master. A `qwen` started in a bare
# terminal is owned by that terminal and nothing else can ever attach to it,
# which is why mogeung can only *point at* such a session. tmux owns the pty
# instead, and is built for several clients at once, so the same live session
# can be in a mogeung pane and in your terminal simultaneously. See ADR-0010.
#
# `--approval-mode yolo` is the equivalent of `claude --dangerously-skip-permissions`,
# and for Qwen it buys something extra. Qwen writes nothing to disk when a tool
# blocks on approval, so mogeung cannot tell a session waiting for your yes from
# one busily working (feature 0036, ADR-0029). Under `yolo` there are no
# approval prompts, so that blind spot cannot be hit. Pass `--approval-mode auto`
# through if you want the classifier to block risky calls instead — the blind
# spot comes back, and the session will read as *working* while it waits.
#
# Nothing here traps the session. Detach and it keeps running; attach from any
# terminal with `tmux attach -t <name>`; kill mogeung and nothing happens to it.
#
# mogeung never runs this for you. You run it; mogeung notices. ADR-0003.
#
# bash 3.2, which is what macOS ships.

set -uo pipefail

detach=0
if [ "${1:-}" = "-d" ] || [ "${1:-}" = "--detach" ]; then
  detach=1
  shift
fi
# Allow `qwenmo -- <qwen args>` so a leading `-m`/`-p` is not mistaken for ours.
if [ "${1:-}" = "--" ]; then
  shift
fi

# Qwen's installer puts the binary in ~/.local/bin, which is not on every
# shell's PATH — `command -v qwen` fails in a login shell that never sourced a
# profile, and `yolomo` never had to think about this because `claude` installs
# itself onto PATH. Resolving it here beats a "command not found" from inside a
# detached tmux session, where nobody sees the error.
qwen_bin=""
if command -v qwen >/dev/null 2>&1; then
  qwen_bin="qwen"
else
  for candidate in \
    "$HOME/.local/bin/qwen" \
    "$HOME/.qwen/bin/qwen" \
    "/usr/local/bin/qwen" \
    "/opt/homebrew/bin/qwen"; do
    if [ -x "$candidate" ]; then
      qwen_bin="$candidate"
      break
    fi
  done
fi
if [ -z "$qwen_bin" ]; then
  echo "qwenmo: cannot find the qwen binary." >&2
  echo "        Looked on PATH, then in ~/.local/bin, ~/.qwen/bin," >&2
  echo "        /usr/local/bin and /opt/homebrew/bin." >&2
  exit 1
fi

# Already inside tmux. Nesting gains nothing and would make the pane mapping
# ambiguous, so just run qwen here — unless -d, where no attach happens and so
# nothing nests: creating a detached session from inside tmux is fine.
if [ "$detach" -eq 0 ] && [ -n "${TMUX:-}" ]; then
  exec "$qwen_bin" --approval-mode yolo ${1+"$@"}
fi

if ! command -v tmux >/dev/null 2>&1; then
  if [ "$detach" -eq 1 ]; then
    # A plain fallback would run qwen in *this* terminal — the opposite of
    # headless — so refuse loudly instead of surprising the caller.
    echo "qwenmo: -d needs tmux, and tmux is not installed." >&2
    exit 1
  fi
  echo "qwenmo: tmux is not installed — falling back to a plain session." >&2
  echo "        mogeung will be able to see it but not host it." >&2
  exec "$qwen_bin" --approval-mode yolo ${1+"$@"}
fi

dir=$(pwd)
# tmux parses ':' and '.' as target separators, so a session named after a
# directory containing them would be unaddressable. Everything outside a safe
# set becomes a dash rather than being dropped, so two different directories
# cannot collapse onto one name.
safe=$(basename "$dir" | sed 's/[^A-Za-z0-9_-]/-/g')
base="mogeung-qwen-${safe}"

# Each run gets its own session — running qwenmo twice in one directory means
# two agents working in parallel, not a second window onto the first one
# (which is what silently happened before, and looks exactly like "my second
# agent never started"). First free suffix wins, so names stay predictable.
#
# `=` is tmux's exact-match prefix. Without it `has-session -t foo` also
# matches `foobar`, and the count would include the wrong project's sessions.
name="$base"
n=2
while tmux has-session -t "=${name}" 2>/dev/null; do
  name="${base}-${n}"
  n=$((n + 1))
done

tmux new-session -d -s "$name" -c "$dir" \
  "$qwen_bin" --approval-mode yolo ${1+"$@"} || {
    echo "qwenmo: could not create the tmux session" >&2
    exit 1
  }

# Size to whichever client is being used, rather than to the smallest one.
# The default is `smallest`, which would let a narrow mogeung pane shrink a
# full-screen terminal attached to the same session — silent, and baffling
# when it happens to you.
# `-w` and the trailing `:` are both load-bearing. `window-size` is a *window*
# option, so without `-w` tmux 3.6 answers "no such window: =mogeung-…" and the
# option is never set — silently, on stderr, after the session has already
# started. This script's first version had that bug because it was copied from
# `yolomo`, which had carried it unnoticed: the failure mode is not a crash but
# the absence of the protection the comment above describes.
tmux set-option -w -t "=${name}:" window-size latest >/dev/null

if [ "$detach" -eq 1 ]; then
  # The name on stdout so scripts can capture it; the human note on stderr.
  echo "$name"
  echo "qwenmo: started headless — mogeung will pick it up on its next scan." >&2
  echo "        attach a terminal any time with: tmux attach -t ${name}" >&2
  exit 0
fi

exec tmux attach-session -t "=${name}"

#!/usr/bin/env bash
# Start `claude` inside a tmux session that mogeung can host in a pane.
#
#   yolomo                  start a NEW session for this directory
#   yolomo -d               same, but headless: don't attach this terminal.
#                           mogeung's Terminal pane becomes the session's only
#                           head; the session name is printed for scripting.
#   yolomo -r               anything after the flags is passed through to claude
#
# Every run starts a fresh agent: two runs in one directory are two sessions
# (mogeung-api, mogeung-api-2, …), not two clients of one agent. To re-attach
# to a session you detached from (or started with -d), use tmux directly:
#
#   tmux attach -t mogeung-<dir>
#
# This is `yolo` — `claude --dangerously-skip-permissions` — with one change:
# the session runs under tmux. That matters because a pty has exactly one
# master. A `claude` started in a bare terminal is owned by that terminal and
# nothing else can ever attach to it, which is why mogeung can only *point at*
# such a session. tmux owns the pty instead, and is built for several clients at
# once, so the same live session can be in a mogeung pane and in your terminal
# simultaneously. See ADR-0010.
#
# Nothing here traps the session. Detach and it keeps running; attach from any
# terminal with `tmux attach -t <name>`; kill mogeung and nothing happens to it.
#
# bash 3.2, which is what macOS ships.

set -uo pipefail

detach=0
if [ "${1:-}" = "-d" ] || [ "${1:-}" = "--detach" ]; then
  detach=1
  shift
fi

# Already inside tmux. Nesting gains nothing and would make the pane mapping
# ambiguous, so just be `yolo` — unless -d, where no attach happens and so
# nothing nests: creating a detached session from inside tmux is fine.
if [ "$detach" -eq 0 ] && [ -n "${TMUX:-}" ]; then
  exec claude --dangerously-skip-permissions ${1+"$@"}
fi

if ! command -v tmux >/dev/null 2>&1; then
  if [ "$detach" -eq 1 ]; then
    # A plain fallback would run claude in *this* terminal — the opposite of
    # headless — so refuse loudly instead of surprising the caller.
    echo "yolomo: -d needs tmux, and tmux is not installed." >&2
    exit 1
  fi
  echo "yolomo: tmux is not installed — falling back to a plain session." >&2
  echo "        mogeung will be able to see it but not host it." >&2
  exec claude --dangerously-skip-permissions ${1+"$@"}
fi

dir=$(pwd)
# tmux parses ':' and '.' as target separators, so a session named after a
# directory containing them would be unaddressable. Everything outside a safe
# set becomes a dash rather than being dropped, so two different directories
# cannot collapse onto one name.
safe=$(basename "$dir" | sed 's/[^A-Za-z0-9_-]/-/g')
base="mogeung-${safe}"

# Each run gets its own session — running yolomo twice in one directory means
# two agents working in parallel, not a second window onto the first one
# (which is what silently happened before, and looks exactly like "my second
# agent never started"). First free suffix wins, so names stay predictable.
#
# `=` is tmux's exact-match prefix. Without it `has-session -t foo` also
# matches `foobar`, and the count would include the wrong project's sessions.
name="$base"
n=2
while tmux has-session -t "=${name}" 2>/dev/null; do
  name="${base}-${n}"
  n=$((n + 1))
done

tmux new-session -d -s "$name" -c "$dir" \
  claude --dangerously-skip-permissions ${1+"$@"} || {
    echo "yolomo: could not create the tmux session" >&2
    exit 1
  }

# Size to whichever client is being used, rather than to the smallest one.
# The default is `smallest`, which would let a narrow mogeung pane shrink a
# full-screen terminal attached to the same session — silent, and baffling
# when it happens to you.
tmux set-option -t "=${name}" window-size latest >/dev/null

if [ "$detach" -eq 1 ]; then
  # The name on stdout so scripts can capture it; the human note on stderr.
  echo "$name"
  echo "yolomo: started headless — mogeung will pick it up on its next scan." >&2
  echo "        attach a terminal any time with: tmux attach -t ${name}" >&2
  exit 0
fi

exec tmux attach-session -t "=${name}"
